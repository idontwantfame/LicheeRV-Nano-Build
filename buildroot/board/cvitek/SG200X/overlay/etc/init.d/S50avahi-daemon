#!/bin/sh
#
# avahi-daemon init script

DAEMON=/usr/sbin/avahi-daemon
case "$1" in
  start)
    # mDNS announces the device on the LAN — opt-in for security.
    # Create /boot/avahi.enable to activate. Without it, avahi still
    # cannot receive queries because S20firewall blocks udp/5353. #442
    [ -e /boot/avahi.enable ] || exit 0
    $DAEMON -c || $DAEMON -D
    ;;
  stop)
    $DAEMON -c && $DAEMON -k
    ;;
  reload)
    $DAEMON -c && $DAEMON -r
    ;;
  *)
    echo "Usage: S50avahi-daemon {start|stop|reload}" >&2
    exit 1
    ;;
esac
