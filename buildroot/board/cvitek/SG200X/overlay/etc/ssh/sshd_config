Port 22
ListenAddress 0.0.0.0

# some old ssh utils need rsa & ecdsa
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# CVE-2024-6387 (regreSSHion) mitigation: disables the SIGALRM race by
# removing the unauthenticated connection timeout entirely.  Acceptable
# because this device is not directly internet-exposed.
LoginGraceTime 0
PermitRootLogin yes

AuthorizedKeysFile .ssh/authorized_keys

# SSH tunnelling not needed for KVM access; creates a pivot if device is compromised. #270
AllowTcpForwarding no
TCPKeepAlive yes
Compression delayed
ClientAliveInterval 60
ClientAliveCountMax 30
UseDNS no

Subsystem sftp /usr/libexec/sftp-server
