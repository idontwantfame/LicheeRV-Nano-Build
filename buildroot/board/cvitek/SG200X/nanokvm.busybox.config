# NanoKVM busybox config fragment
#
# Applied after busybox-extra.config (which targets all SG200X boards).
# Removes applets that have no purpose on a headless KVM appliance and
# adds a small set of tools useful over SSH.

# ---- Runit init system — not used; SysV init (S##) scripts are canonical ----
# busybox-extra.config enables these for other SG200X boards; override here.
# CONFIG_RUNSV is not set
# CONFIG_RUNSVDIR is not set
# CONFIG_SV is not set
# CONFIG_SVC is not set
# CONFIG_SVOK is not set
# CONFIG_SVLOGD is not set

# ---- vi editor — headless appliance; SSH gives access to host editors --------
# CONFIG_VI is not set
# CONFIG_FEATURE_EDITING_VI is not set

# ---- Less pager — head/tail/grep cover all use cases ------------------------
# CONFIG_LESS is not set

# ---- Calculators — never invoked in init scripts or at runtime --------------
# CONFIG_BC is not set
# CONFIG_DC is not set
# CONFIG_FACTOR is not set

# ---- VT / console tools — no local terminal, no display ---------------------
# CONFIG_CHVT is not set
# CONFIG_CLEAR is not set
# CONFIG_DEALLOCVT is not set
# CONFIG_DUMPKMAP is not set
# CONFIG_LOADFONT is not set
# CONFIG_LOADKMAP is not set
# CONFIG_OPENVT is not set
# CONFIG_RESET is not set
# CONFIG_RESIZE is not set
# CONFIG_SETCONSOLE is not set
# CONFIG_SETKEYCODES is not set
# CONFIG_SETLOGCONS is not set

# ---- Framebuffer — kernel BACKLIGHT_CLASS_DEVICE/BACKLIGHT_PWM removed -----
# CONFIG_FBSET is not set

# ---- Data encoding — not invoked anywhere in the NanoKVM runtime ------------
# CONFIG_BASE32 is not set
# CONFIG_UUENCODE is not set
# CONFIG_UUDECODE is not set

# ---- Text formatting — not invoked anywhere ---------------------------------
# CONFIG_FOLD is not set
# CONFIG_PASTE is not set

# ---- Hardware tools irrelevant to NanoKVM -----------------------------------
# CONFIG_EJECT is not set        # no optical drives
# CONFIG_HDPARM is not set       # SD card, not HDD
# CONFIG_HEXEDIT is not set
# CONFIG_MICROCOM is not set     # no serial terminal emulator needed
# CONFIG_MIM is not set          # no modem
# CONFIG_WATCHDOG is not set     # watchdog daemon not used

# ---- Additions: useful for SSH-based administration ------------------------
CONFIG_WATCH=y                   # watch -n 1 <cmd> — remote monitoring without loops
CONFIG_TIMEOUT=y                 # wrap commands that may hang; useful in scripts too
CONFIG_STTY=y                    # inspect/set serial port params (ser2net dependency)
CONFIG_FEATURE_NETSTAT_PRG=y     # netstat -p shows owning PID/process name
