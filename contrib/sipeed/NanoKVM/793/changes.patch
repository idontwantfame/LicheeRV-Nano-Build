diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/ntp.conf b/buildroot/board/cvitek/SG200X/overlay/etc/ntp.conf
new file mode 100644
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/ntp.conf
@@ -0,0 +1,15 @@
+# NanoKVM ntp.conf
+#
+# pool directive continuously re-resolves the hostname and replaces peers as
+# they become available — prevents ntpd from giving up when DNS or the NTP
+# servers are unreachable at cold boot (e.g. upstream router still starting).
+# Individual server entries kept as explicit fallbacks. #793
+pool pool.ntp.org iburst
+server 1.pool.ntp.org iburst
+server 2.pool.ntp.org iburst
+server 3.pool.ntp.org iburst
+server 4.pool.ntp.org iburst
+
+restrict default nomodify nopeer noquery limited kod
+restrict 127.0.0.1
+restrict [::1]
